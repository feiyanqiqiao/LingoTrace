  "language_fields": [
    {
      "name": "ipa",
      "owner": "English language pack",
      "purpose": "IPA phonetic transcription for English review items."
    },
    {
      "name": "word_stress",
      "owner": "English language pack",
      "purpose": "Primary stress pattern or syllable stress notation."
    },
    {
      "name": "part_of_speech",
      "owner": "English language pack",
      "purpose": "Grammatical category such as noun, verb, or adjective."
    },
    {
      "name": "english_definition",
      "owner": "English language pack",
      "purpose": "Concise English-to-English definition."
    },
    {
      "name": "meaning_zh",
      "owner": "English language pack",
      "purpose": "Chinese explanation kept separate from target-language content."
    },
    {
      "name": "collocations",
      "owner": "English language pack",
      "purpose": "Common collocations and lexical bundles."
    },
    {
      "name": "chunk_pattern",
      "owner": "English language pack",
      "purpose": "Productive English chunk used as the speaking-practice target."
    },
    {
      "name": "chunk_type",
      "owner": "English language pack",
      "purpose": "English speaking-chunk classification."
    },
    {
      "name": "chunk_meaning_zh",
      "owner": "English language pack",
      "purpose": "Chinese explanation of a productive English chunk."
    },
    {
      "name": "practice_tier",
      "owner": "English language pack",
      "purpose": "Practice-priority tier for a speaking chunk."
    }
  ],
